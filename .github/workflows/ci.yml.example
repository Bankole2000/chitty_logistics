# Rename to ci.yml after replacing the placeholder steps with real commands (the same
# commands as the README Commands section). Add or remove app jobs to match apps/.
#
# How it works:
# - "changes" works out which apps a PR touches. A change under packages/ or to
#   root config runs every app.
# - Each app job runs only when its app changed (it shows as skipped otherwise).
# - "ci-ok" runs last and fails if any job failed or was cancelled. Make "ci-ok"
#   the ONLY required status check in branch protection: requiring the app jobs
#   directly would block PRs whose app jobs were skipped.
#
# Keeping CI fast and affordable with many apps:
# - This workflow runs on every PR, so keep it to lint, typecheck, unit tests and
#   quick builds. Run them on ubuntu-latest wherever the toolchain allows: Android,
#   most cross-platform mobile/desktop code and their unit tests do.
# - Full native builds, signing, notarization and store uploads belong in
#   release.yml, which runs only for release tags. macOS runners (needed for iOS and
#   macOS builds) are billed at a much higher rate, so avoid them here; if iOS needs
#   a compile check on PRs, run it on a schedule or only when its files change.
#
# Check for newer action major versions, and consider pinning actions to a full
# commit SHA (especially third-party ones such as dorny/paths-filter).
name: CI

on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  changes:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
      pull-requests: read
    outputs:
      customer-web: ${{ steps.filter.outputs['customer-web'] }}
      customer-mobile-app: ${{ steps.filter.outputs['customer-mobile-app'] }}
      driver-web: ${{ steps.filter.outputs['driver-web'] }}
      driver-mobile-app: ${{ steps.filter.outputs['driver-mobile-app'] }}
      admin-web: ${{ steps.filter.outputs['admin-web'] }}
      admin-app: ${{ steps.filter.outputs['admin-app'] }}
      api: ${{ steps.filter.outputs['api'] }}
      worker: ${{ steps.filter.outputs['worker'] }}
    steps:
      - uses: actions/checkout@v7
      - id: filter
        uses: dorny/paths-filter@v4
        with:
          # Root files that affect every app: lockfiles, workspace and tool config.
          # Adjust to the workspace tool chosen in ADR-001 (e.g. add Cargo.toml and Cargo.lock).
          filters: |
            shared: &shared
              - 'packages/**'
              - 'package.json'
              - 'pnpm-lock.yaml'
              - 'pnpm-workspace.yaml'
              - 'package-lock.json'
              - 'turbo.json'
              - '.github/workflows/ci.yml'
            customer-web:
              - *shared
              - 'apps/customer-web/**'
            customer-mobile-app:
              - *shared
              - 'apps/customer-mobile-app/**'
            driver-web:
              - *shared
              - 'apps/driver-web/**'
            driver-mobile-app:
              - *shared
              - 'apps/driver-mobile-app/**'
            admin-web:
              - *shared
              - 'apps/admin-web/**'
            admin-app:
              - *shared
              - 'apps/admin-app/**'
            api:
              - *shared
              - 'apps/api/**'
            worker:
              - *shared
              - 'apps/worker/**'

  repo:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v7
      - name: Check for unfilled template placeholders
        run: bash scripts/check-placeholders.sh
      # ubuntu-latest ships Node, which the features check needs (no dependencies).
      - name: Check features (FEATURES.md references, PRD links, generated parts)
        run: node scripts/check-features.mjs

  customer-web:
    needs: changes
    if: needs.changes.outputs['customer-web'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      # Install, lint, typecheck, unit tests and build for customer-web, using the commands in
      # its README Commands block.
      - name: Fail until configured
        run: |
          echo "Replace with customer-web's install, lint, typecheck, test and build commands."
          exit 1

  customer-mobile-app:
    needs: changes
    if: needs.changes.outputs['customer-mobile-app'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest   # Keep on Linux; signed iOS/macOS builds run in release.yml
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7
      # Lint, typecheck and unit tests only, on Linux. Signed Android and iOS builds run in
      # release.yml.
      - name: Fail until configured
        run: |
          echo "Replace with customer-mobile-app's install, lint and test commands."
          exit 1

  driver-web:
    needs: changes
    if: needs.changes.outputs['driver-web'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      # Install, lint, typecheck, unit tests and build for driver-web, using the commands in
      # its README Commands block.
      - name: Fail until configured
        run: |
          echo "Replace with driver-web's install, lint, typecheck, test and build commands."
          exit 1

  driver-mobile-app:
    needs: changes
    if: needs.changes.outputs['driver-mobile-app'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest   # Keep on Linux; signed iOS/macOS builds run in release.yml
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7
      # Lint, typecheck and unit tests only, on Linux. Signed Android and iOS builds run in
      # release.yml.
      - name: Fail until configured
        run: |
          echo "Replace with driver-mobile-app's install, lint and test commands."
          exit 1

  admin-web:
    needs: changes
    if: needs.changes.outputs['admin-web'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      # Install, lint, typecheck, unit tests and build for admin-web, using the commands in
      # its README Commands block.
      - name: Fail until configured
        run: |
          echo "Replace with admin-web's install, lint, typecheck, test and build commands."
          exit 1

  admin-app:
    needs: changes
    if: needs.changes.outputs['admin-app'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest   # Keep on Linux; signed iOS/macOS builds run in release.yml
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7
      # Lint, typecheck and unit tests only, on Linux. Signed Android, iOS and desktop builds run in
      # release.yml.
      - name: Fail until configured
        run: |
          echo "Replace with admin-app's install, lint and test commands."
          exit 1

  api:
    needs: changes
    if: needs.changes.outputs['api'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    # A database for integration tests, with trust authentication so no password sits
    # in the repository (it only listens inside the runner):
    # services:
    #   postgres:
    #     image: postgres:17
    #     env:
    #       POSTGRES_HOST_AUTH_METHOD: trust
    #     ports: ['127.0.0.1:5432:5432']
    #     options: --health-cmd pg_isready --health-interval 5s --health-retries 10
    steps:
      - uses: actions/checkout@v7
      # Install, lint, typecheck, unit and integration tests and build for api, using the
      # commands in its README Commands block.
      - name: Fail until configured
        run: |
          echo "Replace with api's install, lint, test and build commands."
          exit 1

  worker:
    needs: changes
    if: needs.changes.outputs['worker'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    # A database for integration tests, with trust authentication so no password sits
    # in the repository (it only listens inside the runner):
    # services:
    #   postgres:
    #     image: postgres:17
    #     env:
    #       POSTGRES_HOST_AUTH_METHOD: trust
    #     ports: ['127.0.0.1:5432:5432']
    #     options: --health-cmd pg_isready --health-interval 5s --health-retries 10
    steps:
      - uses: actions/checkout@v7
      # Install, lint, typecheck, unit and integration tests and build for worker, using the
      # commands in its README Commands block.
      - name: Fail until configured
        run: |
          echo "Replace with worker's install, lint, test and build commands."
          exit 1

  ci-ok:
    if: always()
    needs: [changes, repo, customer-web, customer-mobile-app, driver-web, driver-mobile-app, admin-web, admin-app, api, worker]
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Fail if any job failed or was cancelled
        run: |
          if ${{ contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled') }}; then
            echo "One or more jobs failed or were cancelled."
            exit 1
          fi
          echo "All jobs passed or were skipped."
