# api configuration. Copy to apps/api/.env for local overrides; every variable has a default
# that works with docker-compose.yml. Secrets in deployed environments come from the secret
# store named in docs/DEPLOYMENT.md, never from a committed file.

# Where the api runs: development, test, staging or production. Only development may use the development-only TOTP key below; every deployed environment must set this to staging or production. Optional (default: development). Source: choose (the deployment sets it).
API_ENV=development

# Address the server listens on; use 127.0.0.1, not localhost (docs/TECHNICAL.md). Optional (default: 127.0.0.1:18081). Source: choose.
API_BIND=127.0.0.1:18081

# Postgres with PostGIS. Optional (default: postgres://postgres@127.0.0.1:15481/chitty, the docker-compose.yml database). Source: docker-compose.yml locally, the secret store when deployed.
DATABASE_URL=postgres://postgres@127.0.0.1:15481/chitty

# Size of the database connection pool. Optional (default: 10). Source: choose.
DATABASE_MAX_CONNECTIONS=10

# How long a request waits for a database connection, in milliseconds. Optional (default: 2000). Source: choose.
DATABASE_ACQUIRE_TIMEOUT_MS=2000

# Run pending migrations when the server starts, true or false. Optional (default: true). Source: choose.
API_MIGRATE_ON_START=true

# Comma-separated browser origins allowed to call the api; add each client's origins as clients are created. Optional (default: http://127.0.0.1:13000). Source: the clients' dev servers and shells.
API_CORS_ORIGINS=http://127.0.0.1:13000

# Header holding the client's IP address, set (overwritten, not appended to) by the proxy or load balancer in front of the api, e.g. x-real-ip; for an X-Forwarded-For style list the last entry is used. Empty uses the connection's peer address. Used for sign-in rate limits. Optional (default: empty). Source: the hosting platform's documentation.
API_CLIENT_IP_HEADER=

# Log format: text locally, json when deployed. Optional (default: text). Source: choose.
API_LOG_FORMAT=text

# Log filter (tracing EnvFilter syntax). Optional (default: api=info,tower_http=info). Source: choose.
RUST_LOG=api=info,tower_http=info

# --- Staff sign-in (TASK-005) ---

# Key that encrypts staff TOTP secrets at rest: 32 random bytes, base64 (`openssl rand -base64 32`). Secret: never log it or commit a real value; changing it makes every enrolled authenticator unusable. Required unless API_ENV=development, where a public development-only key is used when it is empty (the server logs a warning). Source: the secret store (docs/DEPLOYMENT.md).
TOTP_ENCRYPTION_KEY=

# Fewest characters a staff password may have. Optional (default: 12). Source: choose.
STAFF_PASSWORD_MIN_LENGTH=12

# A staff session unused for this many minutes is refused; each use restarts the clock. Optional (default: 720, 12 hours). Source: choose.
STAFF_SESSION_IDLE_TIMEOUT_MINUTES=720

# Failed sign-in attempts (password or code) allowed per account and per IP address within the window before sign-in answers 429. Optional (default: 5). Source: choose.
STAFF_SIGNIN_MAX_ATTEMPTS=5

# The window, in minutes, that failed sign-in attempts are counted in. Optional (default: 15). Source: choose.
STAFF_SIGNIN_WINDOW_MINUTES=15

# Seconds a staff member has to enter their code after their password (or after enrolment). Optional (default: 300). Source: choose.
STAFF_SIGNIN_CHALLENGE_TTL_SECONDS=300

# Hours an enrolment token printed by `api create-admin` stays valid. Optional (default: 24). Source: choose.
STAFF_ENROLMENT_TOKEN_TTL_HOURS=24
