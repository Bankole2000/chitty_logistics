# Repository-wide tooling only (scripts, local infrastructure such as docker compose).
# Each app has its own apps/<app>/.env.example. Never commit real secrets.
#
# Document every variable in this format:
#   # <What it is>. Required|Optional (default: <value>). Source: <where to get it>.
#   NAME=<safe example value>

# Runtime environment. Required. One of: development, test, production.
APP_ENV=development

# The local database started by docker-compose.yml (Postgres 17 with PostGIS, trust
# authentication, 127.0.0.1 only, port 15481 to stay clear of other projects). Use 127.0.0.1,
# not localhost: trying IPv6 (::1) first can add seconds to every new connection.
# Optional (default: as below). Source: docker-compose.yml.
DATABASE_URL=postgres://postgres@127.0.0.1:15481/chitty
