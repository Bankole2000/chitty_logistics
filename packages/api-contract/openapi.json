{
  "openapi": "3.1.0",
  "info": {
    "title": "Chitty Logistics api",
    "description": "The one server every Chitty Logistics client calls. Every error response has the `ErrorBody` shape (docs/TECHNICAL.md, Error responses).",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18081",
      "description": "Local development"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check the api and its database",
        "description": "Returns 200 when the api and its database answer, and 503 when the database does not. Needs no authentication.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The api and its database answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "database": "ok",
                  "status": "ok"
                }
              }
            }
          },
          "503": {
            "description": "The api answers but its database does not.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "database": "unavailable",
                  "status": "degraded"
                }
              }
            }
          }
        }
      }
    },
    "/staff": {
      "get": {
        "tags": [
          "staff"
        ],
        "summary": "List staff accounts with their roles and status",
        "description": "Every staff account, archived ones included, ordered by name. Not paginated: a staff list stays in the tens. Needs `staff.view`.",
        "operationId": "staff_list",
        "responses": {
          "200": {
            "description": "The staff accounts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffList"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: lacks `staff.view`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "staff_session": []
          }
        ]
      },
      "post": {
        "tags": [
          "staff"
        ],
        "summary": "Invite a staff member with a role",
        "description": "Creates an `invited` account with the role and a single-use invitation valid for `STAFF_INVITE_TTL_HOURS` (default 168, 7 days), delivered by the configured sender. The response never contains the invitation token. The invited person accepts with `POST /staff/enrolment` (the token and a new password) and `POST /staff/sign-in/verify` (the first code), which makes the account `active`. Where no email provider is configured (every environment but development, for now) nothing is created and the answer is 503 `invitation_delivery_unavailable`. Needs `staff.create`.",
        "operationId": "staff_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStaffRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Invited.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffMember"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: lacks `staff.create`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`email_taken`: a staff member with this email exists (archived ones included).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "`invalid_request`: bad email, name, role or reason (`details.fields`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "`invitation_delivery_unavailable` or `invitation_delivery_failed`: the invitation could not be sent; nothing was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "staff_session": []
          }
        ]
      }
    },
    "/staff/enrolment": {
      "post": {
        "tags": [
          "staff-auth"
        ],
        "summary": "Set a password and get a new authenticator secret",
        "description": "With the one-time enrolment token from `api create-admin` or a staff invitation (`POST /staff`), sets the staff member's password and returns a new TOTP secret and otpauth URI (shown once) with a challenge. Complete enrolment with `POST /staff/sign-in/verify` and the first code. The token stays usable until enrolment completes or it expires; using it again replaces the secret. Needs no authentication.",
        "operationId": "staff_enrolment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrolRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Password set; the authenticator secret, shown once.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrolResponse"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_enrolment_token`: unknown, expired or used.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "`invalid_request`: the password is too short or too long.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/staff/me": {
      "get": {
        "tags": [
          "staff-auth"
        ],
        "summary": "The signed-in staff member, their roles and permissions",
        "operationId": "staff_me",
        "responses": {
          "200": {
            "description": "The signed-in staff member.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "staff_session": []
          }
        ]
      }
    },
    "/staff/sign-in": {
      "post": {
        "tags": [
          "staff-auth"
        ],
        "summary": "First step of staff sign-in: email and password",
        "description": "Returns a short-lived challenge to complete with a code at `POST /staff/sign-in/verify`. A wrong email and a wrong password give the same `invalid_credentials` error. Failed attempts are limited per account and per IP address (`STAFF_SIGNIN_MAX_ATTEMPTS` per `STAFF_SIGNIN_WINDOW_MINUTES`). Needs no authentication.",
        "operationId": "staff_sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Password accepted; enter a code next.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChallengeResponse"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_credentials`: wrong email or password, or the account cannot sign in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`totp_enrolment_required`: the password is right but enrolment was not completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited`: too many failed attempts; see the `Retry-After` header.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "description": "Seconds until another attempt is allowed."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/staff/sign-in/verify": {
      "post": {
        "tags": [
          "staff-auth"
        ],
        "summary": "Second step of staff sign-in: the authenticator code",
        "description": "Completes a challenge (from sign-in or enrolment) with the current 6-digit TOTP code and returns a session token, once. Send it as `Authorization: Bearer <token>`. Each code is accepted once; each challenge completes once. Wrong codes count towards the sign-in limit. Needs no authentication.",
        "operationId": "staff_sign_in_verify",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_code`: wrong, old or already used code. `challenge_expired`: the challenge is unknown, expired or already completed. `invalid_enrolment_token`: the enrolment token expired meanwhile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited`: too many failed attempts; see the `Retry-After` header.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "description": "Seconds until another attempt is allowed."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/staff/sign-out": {
      "post": {
        "tags": [
          "staff-auth"
        ],
        "summary": "End the current staff session",
        "description": "Revokes the session whose token the request carries; the token is refused from then on. Other sessions of the same staff member are not affected.",
        "operationId": "staff_sign_out",
        "responses": {
          "204": {
            "description": "Signed out."
          },
          "401": {
            "description": "`unauthenticated`: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "staff_session": []
          }
        ]
      }
    },
    "/staff/{id}": {
      "get": {
        "tags": [
          "staff"
        ],
        "summary": "One staff account with its roles and status",
        "description": "Needs `staff.view`.",
        "operationId": "staff_get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The staff account's id.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The staff account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffMember"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: lacks `staff.view`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: no such staff account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "staff_session": []
          }
        ]
      },
      "patch": {
        "tags": [
          "staff"
        ],
        "summary": "Change a staff member's role",
        "description": "Replaces the account's roles with `role`. Takes effect on the person's next request (permissions are read per request); their sessions stay open. Setting the role they already have changes nothing and writes no audit entry. Refused with `last_admin` when it would leave no active staff member able to manage roles (`staff.edit_role`). Needs `staff.edit_role`.",
        "operationId": "staff_edit_role",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The staff account's id.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditRoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The account with its new role.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffMember"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: lacks `staff.edit_role`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: no such staff account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`last_admin`: the last active staff member able to manage roles would lose that permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "`invalid_request`: unknown role or bad reason (`details.fields`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "staff_session": []
          }
        ]
      }
    },
    "/staff/{id}/archive": {
      "post": {
        "tags": [
          "staff"
        ],
        "summary": "Archive a staff member who has left",
        "description": "Revokes every session of the person at once and ends any unused invitation; they cannot sign in or enrol until restored. Their past audit entries stay. Staff cannot archive themselves (`cannot_archive_self`), and the last active staff member able to manage roles cannot be archived (`last_admin`). Needs `staff.archive`.",
        "operationId": "staff_archive",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The staff account's id.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReasonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Archived.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffMember"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: lacks `staff.archive`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: no such staff account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`cannot_archive_self`, `last_admin`, or `already_archived`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "`invalid_request`: the reason is missing or too long.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "staff_session": []
          }
        ]
      }
    },
    "/staff/{id}/invitation": {
      "post": {
        "tags": [
          "staff"
        ],
        "summary": "Send a new invitation to an invited staff member",
        "description": "For an `invited` account whose invitation expired or was lost: sends a new one, valid for `STAFF_INVITE_TTL_HOURS`; earlier invitations stop working. The response never contains the token. Needs `staff.create`.",
        "operationId": "staff_reissue_invitation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The staff account's id.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A new invitation was sent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffMember"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: lacks `staff.create`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: no such staff account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`not_invited`: the account is active or archived.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "`invitation_delivery_unavailable` or `invitation_delivery_failed`: nothing was changed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "staff_session": []
          }
        ]
      }
    },
    "/staff/{id}/restore": {
      "post": {
        "tags": [
          "staff"
        ],
        "summary": "Restore an archived staff member",
        "description": "A person who had finished enrolment becomes `active` again and signs in with their existing password and authenticator; sessions revoked by archiving stay revoked. A person who had not finished enrolment becomes `invited` and needs a new invitation (`POST /staff/{id}/invitation`). Needs `staff.restore`.",
        "operationId": "staff_restore",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The staff account's id.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReasonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Restored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffMember"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: lacks `staff.restore`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: no such staff account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`not_archived`: the account is not archived.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "`invalid_request`: the reason is missing or too long.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "staff_session": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ChallengeResponse": {
        "type": "object",
        "required": [
          "challenge",
          "expires_at"
        ],
        "properties": {
          "challenge": {
            "type": "string",
            "description": "Sent back with the code to `POST /staff/sign-in/verify`."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateStaffRequest": {
        "type": "object",
        "required": [
          "email",
          "name",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "agent@example.com"
          },
          "name": {
            "type": "string",
            "example": "Ada Obi"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why, recorded in the audit entry. Optional."
          },
          "role": {
            "type": "string",
            "description": "Role key, e.g. `operations`, `admin`, `finance`, `hr`.",
            "example": "operations"
          }
        }
      },
      "EditRoleRequest": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why, recorded in the audit entry. Optional."
          },
          "role": {
            "type": "string",
            "description": "The new role key; replaces the account's current roles.",
            "example": "finance"
          }
        }
      },
      "EnrolRequest": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "format": "password",
            "description": "The new password: at least `STAFF_PASSWORD_MIN_LENGTH` characters (default 12)."
          },
          "token": {
            "type": "string",
            "description": "The one-time enrolment token printed by `api create-admin` or sent in a staff\ninvitation."
          }
        }
      },
      "EnrolResponse": {
        "type": "object",
        "required": [
          "challenge",
          "expires_at",
          "totp"
        ],
        "properties": {
          "challenge": {
            "type": "string",
            "description": "Sent back with the first code to `POST /staff/sign-in/verify`."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "totp": {
            "$ref": "#/components/schemas/TotpSetup"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The body of every error response (docs/TECHNICAL.md, Error responses).",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "example": {
          "error": {
            "code": "not_found",
            "details": null,
            "message": "The requested resource was not found.",
            "request_id": "6f1c2b9e-1d2a-4c3b-9e8f-0a1b2c3d4e5f"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "description": "What went wrong, in a form clients can branch on and show.",
        "required": [
          "code",
          "message",
          "request_id",
          "details"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable snake_case identifier clients branch on, e.g. `not_found`, `forbidden`,\n`unauthenticated`, `invalid_request`, `rate_limited`, `internal`. New codes may be\nadded; existing ones never change meaning.",
            "example": "not_found"
          },
          "details": {
            "type": [
              "object",
              "null"
            ],
            "description": "Code-specific data (e.g. which fields are invalid), or null."
          },
          "message": {
            "type": "string",
            "description": "Human-readable and safe to show; never contains internal details.",
            "example": "The requested resource was not found."
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The request's `x-request-id` (sent by the client or generated), also returned as a\nresponse header."
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "Whether the api and its database answer.",
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "database": {
            "type": "string",
            "description": "`ok`, or `unavailable` when the database does not answer.",
            "example": "ok"
          },
          "status": {
            "type": "string",
            "description": "`ok` when everything answers, `degraded` when the database does not.",
            "example": "ok"
          }
        }
      },
      "Me": {
        "type": "object",
        "description": "The signed-in staff member.",
        "required": [
          "id",
          "email",
          "name",
          "status",
          "roles",
          "permissions"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Permission keys the roles give, e.g. `driver.approve`.",
            "example": [
              "driver.view",
              "driver.approve"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Role keys, e.g. `admin`, `operations`.",
            "example": [
              "admin"
            ]
          },
          "status": {
            "type": "string",
            "description": "`active` (only active staff can be signed in).",
            "example": "active"
          }
        }
      },
      "ReasonRequest": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "description": "Why, recorded in the audit entry. Required, at most 1000 characters.",
            "example": "Left the company on 2026-11-30"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "token",
          "token_type",
          "expires_at",
          "staff"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the session ends if unused; each use moves it forward."
          },
          "staff": {
            "$ref": "#/components/schemas/Me"
          },
          "token": {
            "type": "string",
            "description": "Send as `Authorization: Bearer <token>`. Returned once."
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          }
        }
      },
      "SignInRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@example.com"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "StaffList": {
        "type": "object",
        "required": [
          "staff"
        ],
        "properties": {
          "staff": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StaffMember"
            },
            "description": "Every staff account, archived ones included, by name."
          }
        }
      },
      "StaffMember": {
        "type": "object",
        "description": "A staff account as admins see it. Never contains a password, secret or token.",
        "required": [
          "id",
          "email",
          "name",
          "status",
          "roles",
          "created_at"
        ],
        "properties": {
          "archived_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the account was archived; null unless `archived`."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "invitation_expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the newest unused invitation of an `invited` account expires; null otherwise or\nwhen every invitation has expired (reissue one with `POST /staff/{id}/invitation`)."
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Role keys, e.g. `operations`.",
            "example": [
              "operations"
            ]
          },
          "status": {
            "type": "string",
            "description": "`invited`, `active` or `archived`.",
            "example": "active"
          }
        }
      },
      "TotpSetup": {
        "type": "object",
        "description": "What an authenticator app needs. Returned once; the server keeps only an encrypted copy.",
        "required": [
          "secret",
          "otpauth_uri",
          "algorithm",
          "digits",
          "period"
        ],
        "properties": {
          "algorithm": {
            "type": "string",
            "example": "SHA1"
          },
          "digits": {
            "type": "integer",
            "format": "int32",
            "example": 6,
            "minimum": 0
          },
          "otpauth_uri": {
            "type": "string",
            "description": "`otpauth://totp/…`, for a QR code."
          },
          "period": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds each code lasts.",
            "example": 30,
            "minimum": 0
          },
          "secret": {
            "type": "string",
            "description": "Base32, for typing into an authenticator app."
          }
        }
      },
      "VerifyRequest": {
        "type": "object",
        "required": [
          "challenge",
          "code"
        ],
        "properties": {
          "challenge": {
            "type": "string",
            "description": "From `POST /staff/sign-in` or `POST /staff/enrolment`."
          },
          "code": {
            "type": "string",
            "description": "The 6-digit code the authenticator app shows now.",
            "example": "123456"
          }
        }
      }
    },
    "securitySchemes": {
      "staff_session": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque staff session token from POST /staff/sign-in/verify."
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness of the api and its database"
    },
    {
      "name": "staff-auth",
      "description": "Staff sign-in with email, password and an authenticator code; sessions and sign-out"
    },
    {
      "name": "staff",
      "description": "Staff accounts: invite with a role, change roles, archive and restore (admins)"
    }
  ]
}
