meta {
  name: Invite
  type: http
  seq: 2
}

docs {
  Invites a staff member with a role (needs staff.create). The response never contains
  the invitation token: with API_ENV=development the api logs it, and the invited person
  uses it with "Enrolment" in the staff-auth folder. Elsewhere, until an email provider is
  chosen, this answers 503 invitation_delivery_unavailable. Stores staffId for the
  requests below.
}

post {
  url: {{baseUrl}}/staff
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffSessionToken}}
}

body:json {
  {
    "email": "agent@example.com",
    "name": "Ada Agent",
    "role": "operations",
    "reason": "New operations agent"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("staffId", res.body.id);
  }
}

assert {
  res.status: eq 201
  res.body.status: eq invited
}
